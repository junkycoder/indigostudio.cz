# Security headers pro celý Worker (servíruje statiku přes asset binding).
#
# CSP whitelist:
#   - script-src 'unsafe-inline' (potřebujeme pro inline <script> v HTML — nemáme build krok)
#                js.stripe.com (Payment Element loader)
#                static.cloudflareinsights.com (CF Web Analytics beacon)
#   - style-src 'unsafe-inline' (inline <style> v HTML)
#   - frame-src js.stripe.com + m.stripe.network (Stripe 3DS / Apple Pay overlay)
#   - connect-src api.stripe.com + r.stripe.com (Stripe Elements telemetry)
#   - img-src data: + https: (Stripe wallet ikony, audit screenshoty z R2 přes /api/)
#
# Pokud někdy zbavíme inline scriptů, přepneme na nonce-based CSP.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), payment=*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://static.cloudflareinsights.com; frame-src 'self' https://js.stripe.com https://m.stripe.network https://hooks.stripe.com; connect-src 'self' https://api.stripe.com https://r.stripe.com https://m.stripe.network; font-src 'self'; base-uri 'self'; form-action 'self'
