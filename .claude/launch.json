{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fakan.cz static server",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "http-server",
        "public",
        "-p",
        "8080",
        "-e",
        "html",
        "-c-1",
        "--silent"
      ],
      "port": 8080
    },
    {
      "name": "indigostudio static (auto port)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "http-server",
        "public",
        "-e",
        "html",
        "-c-1",
        "--silent"
      ],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "marketing static (auto port)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "http-server",
        "marketing",
        "-c-1",
        "--silent"
      ],
      "port": 8082,
      "autoPort": true
    },
    {
      "name": "indigostudio worker (wrangler dev)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "podniky worker (wrangler dev)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "/Users/junkycoder/podniky.indigostudio.cz",
        "wrangler",
        "dev",
        "--cwd",
        "/Users/junkycoder/podniky.indigostudio.cz",
        "--port",
        "8790"
      ],
      "port": 8790
    },
    {
