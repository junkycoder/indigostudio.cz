        "dev",
        "--cwd",
        "/Users/junkycoder/podniky.indigostudio.cz",
        "--local-upstream",
        "nekvasil.indigostudio.cz",
        "--test-scheduled",
        "--port",
        "8791"
      ],
      "port": 8791
    },
    {
