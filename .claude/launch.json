{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fakan.cz static server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "public", "-p", "8080", "-e", "html", "-c-1", "--silent"],
      "port": 8080
    },
    {
      "name": "indigostudio static (auto port)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "public", "-e", "html", "-c-1", "--silent"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
