{
  "manifest_version": 2,
  "name": "WhiteApp",
  "version": "1.0.0",
  "description": "Default browser extension",
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "content_scripts": [],
  "applications": {
    "gecko": {
      "id": "whiteapp@fakan.cz",
      "strict_min_version": "91.0"
    }
  }
}
