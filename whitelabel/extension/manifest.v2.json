{
  "manifest_version": 2,
  "name": "AcmeApp",
  "version": "1.0.0",
  "description": "Acme Corp browser extension",
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "https://acme.com/*",
    "https://*.acme.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://acme.com/*",
        "https://*.acme.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "applications": {
    "gecko": {
      "id": "acmeapp@acme.com",
      "strict_min_version": "91.0"
    }
  }
}
