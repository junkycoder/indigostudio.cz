{
  "name": "WhiteApp",
  "bundleId": "cz.fakan.whiteapp",
  "version": "1.0.0",
  "description": "Default whitelabel application",
  "colors": {
    "accent": "#22c55e",
    "background": "#0d0d0d",
    "surface": "#1a1a1a",
    "border": "#2a2a2a",
    "text": "#f0f0f0",
    "textMuted": "#888888"
  },
  "capabilities": {
    "camera": false,
    "location": false,
    "microphone": false,
    "notifications": true,
    "storage": true
  },
  "permissions": {
    "android": ["android.permission.INTERNET", "android.permission.ACCESS_NETWORK_STATE"],
    "ios": []
  },
  "extension": {
    "permissions": ["storage", "notifications"],
    "host_permissions": [],
    "content_scripts_match": [],
    "description": "Default browser extension",
    "firefox_id": "whiteapp@fakan.cz"
  }
}
